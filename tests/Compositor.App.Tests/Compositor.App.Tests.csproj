<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xUnit test naming convention uses underscores (Method_Scenario); allow it -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <!-- Only the subject-model spike needs the runtime; the app itself does not reference it yet,
         so keeping it here stops ~16 MB of native OnnxRuntime shipping in every release zip. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Compositor.App\Compositor.App.csproj" />
    <ProjectReference Include="..\..\src\Compositor.Core\Compositor.Core.csproj" />
  </ItemGroup>
</Project>
